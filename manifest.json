{
  "manifest_version": 3,
  "name": "哔哩喵 (Bili-Mux)",
  "version": "1.1.3",
  "description": "哔哩喵 — 解析B站视频直链与封面，支持分P批量、FLV合并下载、视频流与音频流分别保存、浏览器内 ffmpeg.wasm 合成 MP4。仅供个人学习留存，勿二次分发。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["downloads", "declarativeNetRequestWithHostAccess", "offscreen"],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup.html",
    "default_title": "哔哩喵 (Bili-Mux)"
  },
  "host_permissions": [
    "*://*.bilibili.com/*",
    "*://*.bilivideo.com/*",
    "*://*.bilivideo.cn/*",
    "*://*.hdslb.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.bilibili.com/video/*",
        "*://bilibili.com/video/*",
        "*://m.bilibili.com/video/*",
        "*://www.bilibili.com/list/*",
        "*://bilibili.com/list/*",
        "*://m.bilibili.com/list/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["lib/ffmpeg/*", "icons/icon128.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "referer-rule",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
